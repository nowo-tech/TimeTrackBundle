{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, inline SVG icons). The TimeTrack and TaskBoard pages render in it too
    (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}TimeTrack Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('nowo_time_track_index') }}">TimeTrack Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('nowo_task_board_index') }}"{% if _route starts with 'nowo_task_board' %} aria-current="page"{% endif %}>{{ 'nav.board'|trans({}, 'NowoTaskBoardBundle') }}</a>
            <a class="nowo-ui-link" href="{{ path('nowo_time_track_index') }}"{% if _route == 'nowo_time_track_index' %} aria-current="page"{% endif %}>{{ 'nav.timer'|trans({}, 'NowoTimeTrackBundle') }}</a>
            <a class="nowo-ui-link" href="{{ path('nowo_time_track_reports') }}"{% if _route == 'nowo_time_track_reports' %} aria-current="page"{% endif %}>{{ 'nav.reports'|trans({}, 'NowoTimeTrackBundle') }}</a>
            <a class="nowo-ui-link" href="{{ path('app_timesheet') }}"{% if _route starts with 'app_timesheet' %} aria-current="page"{% endif %}>{{ 'demo.nav.timesheet'|trans }}</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
