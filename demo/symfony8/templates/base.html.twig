{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). The TimeTrack and TaskBoard pages render in it too
    (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'TimeTrack',
    home_route: 'nowo_time_track_index',
    repository: 'https://github.com/nowo-tech/TimeTrackBundle',
    translation_domain: false,
    auth: {},
    nav: [
        {label: 'nav.board'|trans({}, 'NowoTaskBoardBundle'), route: 'nowo_task_board_index', active: ['nowo_task_board_*'], section: 'TaskBoard'},
        {label: 'nav.timer'|trans({}, 'NowoTimeTrackBundle'), route: 'nowo_time_track_index', active: ['nowo_time_track_index'], section: 'TimeTrack'},
        {label: 'nav.reports'|trans({}, 'NowoTimeTrackBundle'), route: 'nowo_time_track_reports', section: 'TimeTrack'},
        {label: 'demo.nav.timesheet'|trans, route: 'app_timesheet', active: ['app_timesheet*'], section: 'TimeTrack'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}TimeTrack Demo{% endblock %} — Symfony 8{% endblock %}
