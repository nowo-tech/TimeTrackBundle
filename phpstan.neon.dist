includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        # 2.0 W1-1 fixtures: classes that implement the removed host port interfaces on purpose (they cannot be loaded).
        - tests/Fixtures/RemovedPorts/*
    scanFiles:
        - tests/phpstan-stubs/App/Entity/User.php
    ignoreErrors: []
    reportUnmatchedIgnoredErrors: false
    # 1.27.0 (Beacon spec 239): PhpStanFrankenPhp 1.4 worker load-readiness rules (ruleset-worker.neon is already
    # included, so they are enabled through their parameters). Every write goes through the bundle's transaction runner.
    frankenphp:
        flagRollbackAfterNestedBegin: true
        flagFlushInHandWrittenTransaction: true
        flagUnboundedRecursion: true
        flagFlushWithoutClosedManagerRecovery: true
    treatPhpDocTypesAsCertain: false
