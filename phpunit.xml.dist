<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[direct]=0"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
        <!-- 1.27.0 (Beacon spec 239): lock waits and concurrent processes on a real server (TIME_TRACK_TEST_DATABASE_URL);
             skipped on SQLite. CI job "Load readiness" runs it with fail-on-skipped. -->
        <testsuite name="database">
            <directory>tests/Database</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Resources</directory>
            <file>src/Integration/TaskProviderInterface.php</file>
            <file>src/Integration/TeamContextProviderInterface.php</file>
            <file>src/Client/ClientAuthenticatorInterface.php</file>
            <file>src/Repository/TimeEntryRepositoryInterface.php</file>
            <file>src/Repository/ActiveTimerRepositoryInterface.php</file>
            <file>src/Repository/ClientTokenRepositoryInterface.php</file>
            <file>src/Repository/PaginatedTimeEntryRepositoryInterface.php</file>
        </exclude>
    </source>
</phpunit>
