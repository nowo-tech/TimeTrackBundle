{#
  BC bridge (deprecated since 1.8, removed in 2.0): wraps a 1.x host layout (web_ui.layout_template /
  templates.layout) that renders `{% block body %}` (and `title`, `stylesheets`, `javascripts`) instead of the UiKit
  canonical blocks. TimeTrackPages::layout() selects it when the configured layout does not define
  nowo_ui_page_header. The page renders in `body` (a 1.x layout that nests nowo_ui_content in `body`, like the
  documented 1.x bridge, gets it there once); canonical blocks the 1.x layout already renders elsewhere
  (nowo_time_track_legacy_blocks: styles, head, flashes, modals, scripts) are not printed a second time; when it renders
  nowo_ui_flashes itself (a copy of the 1.x bundle layout), the page header is printed there, before the flashes.
  Variables: nowo_time_track_legacy_layout, nowo_time_track_legacy_blocks.
#}
{% extends nowo_time_track_legacy_layout %}
{% set _host_blocks = nowo_time_track_legacy_blocks|default([]) %}

{% block title %}{{ block('nowo_ui_document_title') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% if 'nowo_ui_styles' not in _host_blocks %}{{ block('nowo_ui_styles') }}{% endif %}
    {% if 'nowo_ui_head' not in _host_blocks %}{{ block('nowo_ui_head') }}{% endif %}
{% endblock %}

{% block body %}
    {% set _bundle = nowo_ui_bundle|default(null) %}
    <div class="{{ nowo_ui_class('content', _bundle) }}"{% if _bundle %} data-nowo-ui-bundle="{{ _bundle }}"{% endif %}>
        {% if 'nowo_ui_flashes' not in _host_blocks %}
            {{ block('nowo_ui_page_header') }}
            {{ block('nowo_ui_flashes') }}
        {% endif %}
        {{ block('nowo_ui_content') }}
    </div>
    {% if 'nowo_ui_modals' not in _host_blocks %}{{ block('nowo_ui_modals') }}{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if 'nowo_ui_scripts' not in _host_blocks %}{{ block('nowo_ui_scripts') }}{% endif %}
{% endblock %}

{#- Canonical block defaults (the scaffold overrides them; a 1.x layout that renders one of them gets these) -#}
{% block nowo_ui_document_title %}{% endblock %}
{% block nowo_ui_head %}{% endblock %}
{% block nowo_ui_styles %}<link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">{{ nowo_ui_tokens() }}{% endblock %}
{% block nowo_ui_page_header %}{% endblock %}
{% block nowo_ui_flashes %}
    {% if 'nowo_ui_flashes' in _host_blocks %}{{ block('nowo_ui_page_header') }}{% endif %}
    {{ include(nowo_ui_partial('flashes', nowo_ui_bundle|default(null)), {bundle: nowo_ui_bundle|default(null)}) }}
{% endblock %}
{% block nowo_ui_content %}{% endblock %}
{% block nowo_ui_modals %}{% endblock %}
{% block nowo_ui_scripts %}{{ include(nowo_ui_partial('scripts', nowo_ui_bundle|default(null))) }}{% endblock %}
