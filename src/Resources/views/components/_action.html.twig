{#
  One timesheet action (since 1.13): a plain form button. The 1.x inline confirm dialog (reject / reopen, ledger
  reversal and adjustment) was removed in 2.0: those actions open the host's dialog pages on demand
  (options.dialog_urls).
  Variables: form (FormView), label (translated text), primary (bool).
#}
{% trans_default_domain 'NowoTimeTrackBundle' %}
{{ form_start(form, {attr: {class: 'nowo-time-track-action'}}) }}
{{ form_widget(form) }}
<button type="submit" class="{{ nowo_ui_class(primary|default(false) ? 'btn_primary' : 'btn_secondary', 'time_track') }}">{{ label }}</button>
{{ form_end(form, {render_rest: false}) }}
