{#
  Deprecated since 1.8, removed in 2.0 (REQ-TWIG-001 rule 4 shim). The 1.x default layout of the manage pages: the
  pages now extend the UiKit list scaffold and the UiKit admin layout (nowo_ui_kit.layouts.admin), so this file only
  keeps 1.x host templates that extend it (full-file overrides written for 1.x: `{% extends nowo_time_track_layout %}`)
  rendering inside the UiKit admin layout: `title` feeds the document title, `stylesheets` / `javascripts` stack after
  the UiKit assets, `body` is the page content.
#}
{% extends nowo_ui_layout.admin %}

{% block nowo_ui_document_title %}{% block title %}{{ 'page.timer'|trans({}, 'NowoTimeTrackBundle') }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_content %}
    {% block body %}{% endblock %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
