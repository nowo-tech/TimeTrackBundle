{% extends nowo_time_track_layout %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% block title %}{{ 'page.reports'|trans({}, 'NowoTimeTrackBundle') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
<h1>{{ 'page.reports'|trans({}, 'NowoTimeTrackBundle') }}</h1>

<div class="card">
    {% if entries is empty %}
        <p>{{ 'reports.empty'|trans({}, 'NowoTimeTrackBundle') }}</p>
    {% else %}
        <table style="width:100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th align="left">{{ 'reports.task'|trans({}, 'NowoTimeTrackBundle') }}</th>
                    <th align="left">{{ 'reports.started'|trans({}, 'NowoTimeTrackBundle') }}</th>
                    <th align="left">{{ 'reports.duration'|trans({}, 'NowoTimeTrackBundle') }}</th>
                    <th align="left">{{ 'reports.source'|trans({}, 'NowoTimeTrackBundle') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td>{{ entry.taskTitleSnapshot }}</td>
                        <td>{{ entry.startedAt|date('Y-m-d H:i') }}</td>
                        <td>{{ (entry.durationSeconds / 60)|round(1) }} min</td>
                        <td>{{ entry.source.value }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% set _page = entry_page|default(null) %}
        {% if _page and _page.totalPages > 1 %}
            {% set _query = app.request.query.all %}
            <nav class="nowo-ui-pagination" aria-label="{{ 'reports.pagination'|trans({}, 'NowoTimeTrackBundle') }}">
                <span class="nowo-ui-pagination__info">{{ 'reports.page_of'|trans({'%page%': _page.page, '%pages%': _page.totalPages, '%total%': _page.total}, 'NowoTimeTrackBundle') }}</span>
                <span class="nowo-ui-pagination__nav">
                    {% if _page.hasPrevious %}
                        <a class="nowo-ui-pagination__link" rel="prev" href="{{ path(app.request.attributes.get('_route'), _query|merge({page: _page.page - 1})) }}">{{ 'reports.previous'|trans({}, 'NowoTimeTrackBundle') }}</a>
                    {% endif %}
                    {% if _page.hasNext %}
                        <a class="nowo-ui-pagination__link" rel="next" href="{{ path(app.request.attributes.get('_route'), _query|merge({page: _page.page + 1})) }}">{{ 'reports.next'|trans({}, 'NowoTimeTrackBundle') }}</a>
                    {% endif %}
                </span>
            </nav>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
