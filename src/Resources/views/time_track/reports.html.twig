{#
  Reports page (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from TimeTrackPages::reportsPage():
  header page.reports with the period as intro; columns task, started, duration (end-aligned), source (priority 2);
  rows = list<TimeEntry> of the current page; View\Pagination (reports.page_size per page); EmptyState reports.empty;
  data-testid="time-track-reports").
  1.x variables, still passed for host overrides: entries, entry_page, from, to.
  1.11: hidden_task_entry_ids (entry id => true): imported entries whose task the owner cannot see show
  reports.task_not_visible instead of the title snapshot.
  1.15: an entry with no user (only with a list-query listener) shows the person's name, else reports.former_person.
  1.36.0: an entry without a task shows reports.no_task and its description.
  2.1.0: allocation_labels (Subject\AllocationLabels, null while no subject or activity type provider is configured): a
  subject column (priority 2) with the subject label (escaped plain text), subjects.not_visible for a subject the viewer
  may not read (no id), and the activity type label on a neutral badge.
  Data block filled: nowo_ui_list_row (start time, duration in minutes, translated source on the badge_neutral slot).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoTimeTrackBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'reports.task'|trans }}" data-required="1">{% if (hidden_task_entry_ids ?? {})[row.id] is defined %}{{ 'reports.task_not_visible'|trans }}{% elseif not row.hasTask %}<span data-testid="time-track-no-task">{{ 'reports.no_task'|trans }}</span>{% if row.description %} <small class="{{ nowo_ui_class('muted', _b) }}">{{ row.description }}</small>{% endif %}{% else %}{{ row.anonymised and row.taskTitleSnapshot is same as('') ? 'reports.task_not_visible'|trans : row.taskTitleSnapshot }}{% endif %}{% if row.ownerless %} <span class="{{ nowo_ui_class('badge_neutral', _b) }}" data-testid="time-track-former-person">{{ row.personName ?? 'reports.former_person'|trans }}</span>{% endif %}</td>
    {% if allocation_labels ?? null %}
        {% set _subject = allocation_labels.subject(row.scopeKey, row.subject) %}
        {% set _activity = allocation_labels.activityType(row.scopeKey, row.activityTypeKey) %}
        <td class="{{ _cell }}" data-label="{{ 'reports.subject'|trans }}" data-nowo-ui-priority="2" data-testid="time-track-subject">{% if _subject %}{% if _subject.hidden ?? false %}<span class="{{ nowo_ui_class('muted', _b) }}" data-testid="time-track-subject-hidden">{{ 'subjects.not_visible'|trans }}</span>{% else %}{{ _subject.label }}{% endif %}{% endif %}{% if _activity %} <span class="{{ nowo_ui_class('badge_neutral', _b) }}" data-testid="time-track-activity-type">{{ _activity.label }}</span>{% endif %}</td>
    {% endif %}
    <td class="{{ _cell }}" data-label="{{ 'reports.started'|trans }}"><time datetime="{{ row.startedAt|date('c') }}">{{ row.startedAt|date('Y-m-d H:i') }}</time></td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'reports.duration'|trans }}">{{ 'reports.minutes'|trans({'%minutes%': (row.durationSeconds / 60)|round(1)}) }}</td>
    <td class="{{ _cell }}" data-label="{{ 'reports.source'|trans }}" data-nowo-ui-priority="2"><span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ ('reports.source_' ~ row.source.value)|trans }}</span></td>
{% endblock %}
